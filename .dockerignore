# Git
.git
.gitignore

# Docker
docker-compose.yml
Dockerfile*
.dockerignore

# Dependency directories (Let the Dockerfile install these!)
**/node_modules/
**/bower_components/
**/vendor/
**/env/
**/venv/
**/.venv/

# Build outputs
**/dist/
**/build/
**/out/
*.exe
*.dll
*.so

# Environment secrets and logs (nested dirs included — **/.env only matches
# subdirectories, so the root-level entries are listed explicitly too)
.env
**/.env
.env.*
**/.env.*
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
**/.volumes/

# OS metadata
.DS_Store
Thumbs.db

# IDEs and editors
**/.vscode/
**/.idea/
*.swp
*.swo
