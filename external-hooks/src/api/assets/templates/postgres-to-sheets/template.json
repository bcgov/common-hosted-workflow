  "workflow": {
    "settings": {
      "executionOrder": "v1"
    },
    "nodes": [
      {
        "id": "c2cff78f-ab69-5209-8f1f-b2795251d116",
        "name": "Schedule Trigger",
        "type": "n8n-nodes-base.scheduleTrigger",
        "position": [0, 0],
        "typeVersion": 1.2,
        "parameters": {
          "rule": {
            "interval": [
              {
                "field": "days",
                "daysInterval": 1,
                "triggerAtHour": 6,
                "triggerAtMinute": 0
              }
            ]
          }
        }
      },
      {
        "id": "d9a908da-46f8-55e6-8f88-922c9d85ba63",
        "name": "Get unsynced orders",
        "type": "n8n-nodes-base.postgres",
        "position": [220, 0],
        "typeVersion": 2.4,
        "parameters": {
          "operation": "executeQuery",
          "query": "SELECT id, customer, total, created_at FROM orders WHERE exported_at IS NULL ORDER BY created_at"
        }
      },
      {
        "id": "201a7559-631a-5df1-ab72-1a9a0adf89c4",
        "name": "Map to sheet rows",
        "type": "n8n-nodes-base.set",
        "position": [440, 0],
        "typeVersion": 3.4,
        "parameters": {
          "assignments": {
            "assignments": [
              {
                "id": "a1",
                "name": "order_id",
                "value": "={{ $json.id }}",
                "type": "number"
              },
              {
                "id": "a2",
                "name": "customer",
                "value": "={{ $json.customer }}",
                "type": "string"
              },
              {
                "id": "a3",
                "name": "total",
                "value": "={{ $json.total }}",
                "type": "number"
              },
              {
                "id": "a4",
                "name": "created_at",
                "value": "={{ $json.created_at }}",
                "type": "string"
              }
            ]
          },
          "options": {}
        }
      },
      {
        "id": "8543f01e-4cb5-5738-831e-222d075c060b",
        "name": "Append to sheet",
        "type": "n8n-nodes-base.googleSheets",
        "position": [660, 0],
        "typeVersion": 4.4,
        "parameters": {
          "operation": "append",
          "documentId": {
            "__rl": true,
            "mode": "id",
            "value": "YOUR_SPREADSHEET_ID"
          },
          "sheetName": {
            "__rl": true,
            "mode": "name",
            "value": "Orders"
          },
          "columns": {
            "mappingMode": "autoMapInputData"
          },
          "options": {}
        }
      },
      {
        "id": "b6f3f2e1-2d7d-5f6c-8b2a-100100000005",
        "name": "Mark orders as exported",
        "type": "n8n-nodes-base.postgres",
        "position": [880, 0],
        "typeVersion": 2.4,
        "parameters": {
          "operation": "executeQuery",
          "query": "=UPDATE orders SET exported_at = NOW() WHERE id = {{ $('Map to sheet rows').item.json.order_id }} AND exported_at IS NULL"
        }
      }
    ],
    "connections": {
