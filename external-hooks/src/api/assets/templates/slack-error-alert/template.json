                "id": "c3",
                "name": "error",
                "value": "={{ $json.execution.error.message }}",
                "type": "string"
              },
              {
                "id": "c4",
                "name": "url",
                "value": "={{ $json.execution.url }}",
                "type": "string"
              }
            ]
          },
          "options": {}
        }
      },
      {
        "id": "8ee1f857-7c91-58f2-a1cd-2713e9b72691",
        "name": "Notify Slack",
        "type": "n8n-nodes-base.slack",
        "position": [440, 0],
        "typeVersion": 2.3,
        "parameters": {
          "resource": "message",
          "operation": "post",
          "select": "channel",
          "channelId": { "__rl": true, "value": "#alerts", "mode": "name" },
          "text": "=:rotating_light: *{{ $json.workflow }}* failed (execution {{ $json.executionId }})\n{{ $json.error }}\n{{ $json.url }}",
          "otherOptions": {}
        }
      }
    ],
    "connections": {
      "Error Trigger": {
        "main": [[{ "node": "Format alert", "type": "main", "index": 0 }]]
      },
      "Format alert": {
