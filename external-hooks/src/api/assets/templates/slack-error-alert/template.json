        "name": "Format alert",
        "type": "n8n-nodes-base.set",
        "position": [220, 0],
        "typeVersion": 3.4,
        "parameters": {
          "assignments": {
            "assignments": [
              {
                "id": "c1",
                "name": "workflow",
