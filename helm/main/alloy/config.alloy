// Scrape n8n /metrics endpoint (requires N8N_METRICS=true)
// Addresses are injected via environment variables so this file works in both
// docker-compose (ALLOY_N8N_ADDRESS=n8n:5678) and Helm/OpenShift (chwf-n8n-main:5678).
prometheus.scrape "n8n" {
  targets = [{
    "__address__"      = env("ALLOY_N8N_ADDRESS"),
    "__metrics_path__" = "/metrics",
    "job"              = "n8n",
    "app"              = "n8n",
  }]
  scrape_interval = "30s"
  scrape_timeout  = "20s"
  forward_to      = [prometheus.remote_write.mimir.receiver]
}

// Receive OTLP traces from n8n (N8N_OTEL_ENABLED=true) and forward to Tempo
otelcol.receiver.otlp "n8n" {
  http {
    endpoint = "0.0.0.0:4318"
  }
  output {
    traces = [otelcol.processor.transform.rename_spans.input]
  }
}

// Enrich span names with workflow/node names so the Grafana node graph shows
// meaningful labels instead of the generic "workflow.execute" / "node.execute".
// NOTE: after this transform, exact-match TraceQL queries like {name = "workflow.execute"}
// return zero results — use prefix matches instead: {name =~ "workflow.execute.*"}.
otelcol.processor.transform "rename_spans" {
  trace_statements {
    context = "span"
    statements = [
      `set(span.name, Concat([span.name, ": ", span.attributes["n8n.workflow.name"]], "")) where span.name == "workflow.execute" and span.attributes["n8n.workflow.name"] != nil and span.attributes["n8n.workflow.name"] != ""`,
      `set(span.name, Concat([span.name, ": ", span.attributes["n8n.node.name"]], "")) where span.name == "node.execute" and span.attributes["n8n.node.name"] != nil and span.attributes["n8n.node.name"] != ""`,
    ]
  }
  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = env("ALLOY_TEMPO_URL")
    tls {
      insecure = true
    }
  }
  retry_on_failure {
    enabled          = true
    initial_interval = "1s"
    max_interval     = "30s"
    max_elapsed_time = "5m"
  }
}

// Receive n8n log streaming events via syslog TCP and forward to Loki.
// n8n sends one JSON event per syslog message; the MSG body is the full envelope.
loki.source.syslog "n8n_events" {
  listener {
    address  = "0.0.0.0:5514"
    protocol = "tcp"
    labels = {
      job    = "n8n-log-streaming",
      source = "n8n",
    }
  }
  forward_to = [loki.process.n8n_events.receiver]
}

loki.process "n8n_events" {
  stage.json {
    expressions = {
      event_name    = "eventName",
      event_type    = "__type",
      workflow_id   = "payload.workflowId",
      execution_id  = "payload.executionId",
      project_name  = "payload.projectName",
      workflow_name = "payload.workflowName",
      mode          = "payload.mode",
      ts            = "ts",
    }
  }

  stage.labels {
    values = {
      event_name    = "",
      event_type    = "",
      project_name  = "",
      mode          = "",
      workflow_name = "",
      workflow_id   = "",
    }
  }

  stage.timestamp {
    source              = "ts"
    format              = "RFC3339Nano"
    fallback_formats    = ["RFC3339"]
    action_on_failure   = "skip"
  }

  forward_to = [loki.write.loki.receiver]
}

loki.write "loki" {
  endpoint {
    url = env("ALLOY_LOKI_URL")
  }
  // Buffer to disk when Loki is temporarily unavailable; replays on recovery.
  // max_segment_age caps WAL growth — entries older than 1h are dropped rather than filling disk.
  wal {
    enabled         = true
    max_segment_age = "1h"
  }
}

prometheus.remote_write "mimir" {
  endpoint {
    url = env("ALLOY_MIMIR_URL")

    queue_config {
      capacity    = 10000
      min_backoff = "1s"
      max_backoff = "5m"
    }
  }
}
