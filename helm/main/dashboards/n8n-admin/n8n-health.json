{
  "__inputs": [],
  "__requires": [],
  "uid": "n8n-health",
  "title": "n8n Health",
  "tags": ["n8n"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 9,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Heap Used",
      "description": "V8 JavaScript heap currently in use. Rising trend without recovery = memory leak.",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 300000000
              },
              {
                "color": "red",
                "value": 500000000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "n8n_nodejs_heap_size_used_bytes",
          "legendFormat": "Used"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Heap Total",
      "description": "Total V8 heap capacity allocated. Should stay reasonably above Heap Used.",
      "gridPos": {
        "x": 4,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "n8n_nodejs_heap_size_total_bytes",
          "legendFormat": "Total"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Resident Memory (RSS)",
      "description": "Total RAM the n8n process is using as seen by the OS. Includes heap, stack, and native buffers.",
      "gridPos": {
        "x": 8,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 500000000
              },
              {
                "color": "red",
                "value": 1000000000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "n8n_process_resident_memory_bytes",
          "legendFormat": "RSS"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Event Loop Lag (p99)",
      "description": "How long a callback waits before the event loop processes it. >50ms means n8n is overloaded.",
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.05
              },
              {
                "color": "red",
                "value": 0.1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "n8n_nodejs_eventloop_lag_p99_seconds",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "CPU Usage",
      "description": "Fraction of a single CPU core n8n is consuming. >0.8 sustained means the process is CPU-bound.",
      "gridPos": {
        "x": 16,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 0.8
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(n8n_process_cpu_seconds_total[$__rate_interval])",
          "legendFormat": "CPU"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Open File Descriptors",
      "description": "Open sockets and file handles. Steadily increasing = connection or file handle leak.",
      "gridPos": {
        "x": 20,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 500
              },
              {
                "color": "red",
                "value": 900
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "n8n_process_open_fds",
          "legendFormat": "FDs"
        }
      ]
    },
    {
      "id": 21,
      "type": "stat",
      "title": "Active Workflows",
      "description": "Number of workflows currently active (triggers registered with the scheduler). Drop to 0 unexpectedly = workflows deactivated or n8n failed to re-register after restart.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
