          },
          "editorMode": "code",
          "expr": "{job=\"n8n-system-logs\", container=~\"$container\"} |~ \"(?i)($level)\" |~ \"(?i)(error|exception|fatal|panic)\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Error Lines",
