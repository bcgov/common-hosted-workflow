  "description": "Pod stdout/stderr from all n8n components (main, worker, webhook, runner) via Alloy loki.source.kubernetes. Use this for infrastructure-level debugging — errors, restarts, runner lifecycle, and worker queue activity.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "tags": [],
      "targetBlank": false,
      "title": "n8n Logs",
      "tooltip": "",
      "type": "link",
      "url": "/d/n8n-logs/n8n-logs"
    },
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "tags": [],
      "targetBlank": false,
      "title": "n8n Executions",
      "tooltip": "",
      "type": "link",
      "url": "/d/n8n-executions/n8n-executions"
    }
  ],
  "panels": [
    {
      "datasource": {
        "type": "loki",
        "uid": "loki-system"
      },
      "description": "Total log lines from selected n8n pod(s) in the time range. A sudden drop to zero means the pod stopped logging — check for crashes.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "match": "no value",
                "result": {
                  "color": "red",
                  "text": "0"
                }
              },
              "type": "special"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "text",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["sum"],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "10.4.0",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki-system"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({job=\"n8n-system-logs\", container=~\"$container\"} |~ \"(?i)($level)\" [$__range]))",
          "instant": true,
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Total Log Lines",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki-system"
      },
      "description": "Log lines matching error keywords (error, exception, fatal, panic). Any non-zero value warrants investigation.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "match": "no value",
                "result": {
                  "color": "green",
                  "text": "0"
                }
              },
              "type": "special"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["sum"],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "10.4.0",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki-system"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({job=\"n8n-system-logs\", container=~\"$container\"} |~ \"(?i)(error|exception|fatal|panic)\" [$__range]))",
          "instant": true,
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Error Lines",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki-system"
      },
      "description": "Log lines matching warn keywords. Warnings often precede errors — a spike here before an error spike is a useful leading indicator.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "match": "no value",
                "result": {
                  "color": "text",
                  "text": "0"
                }
              },
              "type": "special"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["sum"],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "10.4.0",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki-system"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({job=\"n8n-system-logs\", container=~\"$container\"} |~ \"(?i)(warn)\" [$__range]))",
          "instant": true,
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Warn Lines",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki-system"
      },
      "description": "Error line percentage of total output. A persistently high ratio indicates a component in a bad state.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "match": "no value",
                "result": {
                  "color": "green",
                  "text": "0%"
                }
              },
              "type": "special"
            },
            {
              "options": {
                "match": "nan",
                "result": {
                  "color": "green",
                  "text": "0%"
                }
              },
              "type": "special"
            }
          ],
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "10.4.0",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki-system"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({job=\"n8n-system-logs\", container=~\"$container\"} |~ \"(?i)(error|exception|fatal|panic)\" [$__range])) / sum(count_over_time({job=\"n8n-system-logs\", container=~\"$container\"} [$__range])) * 100",
          "instant": true,
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Error Rate",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki-system"
      },
      "description": "Log throughput per n8n component over time. Gaps in a line mean that pod produced no output — could be idle (normal for runner) or stuck (abnormal for main/worker).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2,
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "id": 5,
      "options": {
        "legend": {
          "calcs": ["sum", "mean"],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki-system"
          },
          "editorMode": "code",
          "expr": "sum by (container) (count_over_time({job=\"n8n-system-logs\", container=~\"$container\"} |~ \"(?i)($level)\" [$__interval]))",
          "instant": false,
          "legendFormat": "{{container}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Log Volume by Component",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki-system"
      },
      "description": "Error and warn lines over time, broken down by component. Correlate spikes here with the workflow execution timeline in the n8n Executions dashboard.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2,
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*error.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*warn.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "orange",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "id": 6,
      "options": {
        "legend": {
          "calcs": ["sum"],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki-system"
          },
          "editorMode": "code",
          "expr": "sum by (container) (count_over_time({job=\"n8n-system-logs\", container=~\"$container\"} |~ \"(?i)($level)\" |~ \"(?i)(error|exception|fatal|panic)\" [$__interval]))",
          "instant": false,
          "legendFormat": "error · {{container}}",
          "queryType": "range",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki-system"
          },
          "editorMode": "code",
          "expr": "sum by (container) (count_over_time({job=\"n8n-system-logs\", container=~\"$container\"} |~ \"(?i)($level)\" |~ \"(?i)(warn)\" [$__interval]))",
          "instant": false,
          "legendFormat": "warn · {{container}}",
          "queryType": "range",
          "refId": "B"
        }
      ],
      "title": "Errors & Warnings Over Time",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki-system"
      },
      "description": "Error and exception lines from all selected components. Expand each line for full context. Use the pod label to correlate with a specific replica.",
      "gridPos": {
