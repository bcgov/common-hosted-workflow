        },
        "datasource": {
          "type": "loki",
          "uid": "loki-system"
        },
        "definition": "",
        "hide": 0,
        "includeAll": true,
        "label": "Component",
        "multi": true,
        "name": "container",
        "options": [],
        "query": {
          "label": "container",
