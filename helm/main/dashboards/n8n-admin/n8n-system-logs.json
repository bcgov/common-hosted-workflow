      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki-system"
          },
          "editorMode": "code",
          "expr": "{job=\"n8n-system-logs\", container=~\"$container\"} |~ \"(?i)($level)\"",
          "queryType": "range",
