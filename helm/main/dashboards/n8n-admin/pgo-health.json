{
  "__inputs": [],
  "__requires": [],
  "uid": "pgo-health",
  "title": "PGO Health",
  "description": "Crunchy PostgreSQL and pgMonitor health collected by Alloy and stored in Mimir.",
  "tags": ["pgo", "postgresql", "crunchy", "pgmonitor"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "pod",
        "label": "PostgreSQL pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "refId": "variable",
          "query": "label_values(up{job=\"pgo\"}, pod)"
        },
        "definition": "label_values(up{job=\"pgo\"}, pod)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "hide": 0,
        "skipUrlSync": false,
        "current": {
          "selected": true,
          "text": ["All"],
          "value": ["$__all"]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Healthy Exporters",
      "description": "Number of PGO exporter targets currently scraped successfully.",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(up{job=\"pgo\", pod=~\"$pod\"})",
          "legendFormat": "Healthy exporters"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Database Available",
      "description": "Minimum pg_up value across selected exporters. Zero means PostgreSQL cannot be queried.",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red" },
                "1": { "text": "UP", "color": "green" }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "min(pg_up{job=\"pgo\", pod=~\"$pod\"})",
          "legendFormat": "Database availability"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Connection Utilization",
      "description": "Highest total active plus idle connection utilization against max_connections.",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "red", "value": 0.85 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(ccp_connection_stats_total{job=\"pgo\", pod=~\"$pod\"} / clamp_min(ccp_connection_stats_max_connections{job=\"pgo\", pod=~\"$pod\"}, 1))",
          "legendFormat": "Connections"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Replication Lag",
      "description": "Largest WAL byte lag reported by a selected primary for any replica.",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 16777216 },
              { "color": "red", "value": 67108864 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(ccp_replication_lag_size_bytes{job=\"pgo\", pod=~\"$pod\"})",
          "legendFormat": "Replication lag"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Local Incremental Backup Age",
      "description": "Age of the latest successful incremental backup in local repo 1. Alert threshold: 96 hours.",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 345600 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(ccp_backrest_last_incr_backup_time_since_completion_seconds{job=\"pgo\", pod=~\"$pod\", repo=\"1\"})",
          "legendFormat": "Backup age"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Application Database Size",
      "description": "Combined size of non-postgres databases, using the largest value across selected HA exporters to avoid double counting.",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "color": { "mode": "text" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(max by (dbname) (ccp_database_size_bytes{job=\"pgo\", pod=~\"$pod\", dbname!=\"postgres\"}))",
          "legendFormat": "Application databases"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Connections Over Time",
      "description": "Active and idle sessions per exporter, with max_connections as the capacity ceiling.",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max by (pod) (ccp_connection_stats_active{job=\"pgo\", pod=~\"$pod\"})",
          "legendFormat": "{{pod}} active"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max by (pod) (ccp_connection_stats_idle{job=\"pgo\", pod=~\"$pod\"})",
          "legendFormat": "{{pod}} idle"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max by (pod) (ccp_connection_stats_max_connections{job=\"pgo\", pod=~\"$pod\"})",
          "legendFormat": "{{pod}} maximum"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Replication Lag Over Time",
      "description": "WAL bytes between the primary and each connected replica. No series is expected when no replica is connected.",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max by (pod, replica) (ccp_replication_lag_size_bytes{job=\"pgo\", pod=~\"$pod\"})",
          "legendFormat": "{{pod}} → {{replica}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Database Size Over Time",
      "description": "Size by database. Max across selected HA exporters avoids counting the same database twice.",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max by (dbname) (ccp_database_size_bytes{job=\"pgo\", pod=~\"$pod\"})",
          "legendFormat": "{{dbname}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Incremental Backup Age Over Time",
      "description": "Time since the latest successful incremental backup in each repository. Local backup alerting covers repo 1.",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max by (repo) (ccp_backrest_last_incr_backup_time_since_completion_seconds{job=\"pgo\", pod=~\"$pod\"})",
          "legendFormat": "Repo {{repo}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Transaction Wraparound Progress",
      "description": "Progress towards emergency autovacuum. Sustained growth requires investigation before transaction ID exhaustion.",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max by (pod) (ccp_transaction_wraparound_percent_towards_emergency_autovac{job=\"pgo\", pod=~\"$pod\"})",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Buffer Cache Hit Ratio",
      "description": "PostgreSQL buffer hits divided by hits plus disk reads. Lower sustained values can indicate memory or query pressure.",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max by (dbname) (ccp_stat_database_blks_hit{job=\"pgo\", pod=~\"$pod\"} / clamp_min(ccp_stat_database_blks_hit{job=\"pgo\", pod=~\"$pod\"} + ccp_stat_database_blks_read{job=\"pgo\", pod=~\"$pod\"}, 1))",
          "legendFormat": "{{dbname}}"
        }
      ]
    }
  ],
  "links": []
}
