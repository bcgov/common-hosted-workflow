        ],
        "footer": {
          "show": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by(workflow_id, workflow_name, mode, status)(increase(n8n_workflow_execution_duration_seconds_count{mode=~\"$mode\"}[$__range]) * on(workflow_id) group_left(workflow_name) (max by(workflow_id, workflow_name)(last_over_time(n8n_workflow_started_total{workflow_name=~\"$workflow_name\"}[$__range])) * 0 + 1))",
          "legendFormat": ""
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": ["workflow_id", "workflow_name", "mode", "status", "Value"]
            }
          }
        }
      ]
