{
  "__inputs": [],
  "__requires": [],
  "uid": "n8n-executions",
  "title": "n8n Executions",
  "tags": ["n8n"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 36,
  "refresh": "30s",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "mode",
        "label": "Execution Type",
        "type": "custom",
        "query": "All : .*,Webhook : webhook,Scheduled : trigger,Manual : manual",
        "definition": "All : .*,Webhook : webhook,Scheduled : trigger,Manual : manual",
        "current": {
          "selected": true,
          "text": "All",
          "value": ".*"
        },
        "options": [
          {
            "selected": true,
            "text": "All",
            "value": ".*"
          },
          {
            "selected": false,
            "text": "Webhook",
            "value": "webhook"
          },
          {
            "selected": false,
            "text": "Scheduled",
            "value": "trigger"
          },
          {
            "selected": false,
            "text": "Manual",
            "value": "manual"
          }
        ],
        "includeAll": false,
        "allValue": null,
        "multi": false,
        "hide": 0,
        "skipUrlSync": false
      },
      {
        "name": "workflow_name",
        "label": "Workflow",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(n8n_workflow_started_total, workflow_name)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "hide": 0,
        "skipUrlSync": false,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total Executions",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(n8n_workflow_execution_duration_seconds_count{mode=~\"$mode\"}[$__range]) and on(workflow_id) max by(workflow_id)(last_over_time(n8n_workflow_started_total{workflow_name=~\"$workflow_name\"}[$__range])))",
          "legendFormat": "Total"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Successful",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
