        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by(status)(rate(n8n_workflow_execution_duration_seconds_count{mode=~\"$mode\"}[$__rate_interval]) and on(workflow_id) max by(workflow_id)(last_over_time(n8n_workflow_started_total{workflow_name=~\"$workflow_name\"}[$__range]))) * 60",
          "legendFormat": "{{status}}"
