          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(n8n_workflow_execution_duration_seconds_count{mode=~\"$mode\"}[$__range]) and on(workflow_id) max by(workflow_id)(last_over_time(n8n_workflow_started_total{workflow_name=~\"$workflow_name\"}[$__range]))) * 60",
          "legendFormat": "exec/min"
        }
      ]
