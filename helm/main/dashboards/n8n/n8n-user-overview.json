    {
      "id": 30,
      "type": "timeseries",
      "title": "Execution Duration \u2014 p50 / p90 / p99",
      "description": "Duration percentiles over time. A widening gap between p99 and p50 indicates slow outlier executions.",
      "gridPos": {
        "h": 9,
        "w": 14,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "p50"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p90"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "yellow",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p99"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": false,
          "expr": "histogram_quantile(0.5, sum by(le)(n8n:workflow_execution_duration_seconds_bucket:rate5m{workflow_id=~\"$workflow_id\"}))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": false,
          "expr": "histogram_quantile(0.9, sum by(le)(n8n:workflow_execution_duration_seconds_bucket:rate5m{workflow_id=~\"$workflow_id\"}))",
          "legendFormat": "p90"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": false,
          "expr": "histogram_quantile(0.99, sum by(le)(n8n:workflow_execution_duration_seconds_bucket:rate5m{workflow_id=~\"$workflow_id\"}))",
          "legendFormat": "p99"
        }
      ]
    },
    {
