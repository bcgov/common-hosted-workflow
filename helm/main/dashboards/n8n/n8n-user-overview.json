    {
      "id": 24,
      "type": "stat",
      "title": "Success Rate",
      "description": "Successful executions as a percentage of terminal executions",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
