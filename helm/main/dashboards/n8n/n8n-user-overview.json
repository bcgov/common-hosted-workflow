      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({job=\"n8n-log-streaming\", project_id=~\"$project_id\", event_name=\"n8n.workflow.failed\", workflow_id=~\"$workflow_id\"}[$__range]))",
          "instant": true,
          "legendFormat": "__auto",
          "queryType": "instant",
          "refId": "A"
