          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{span.n8n.workflow.id =~ \"${workflow_id}\" && span.n8n.project.id =~ \"${project_id}\" && (${status})} | select(span.n8n.workflow.name, span.n8n.project.custom.name, span.n8n.execution.id, span.n8n.execution.mode, span.n8n.execution.status, span.n8n.execution.is_retry, span.n8n.execution.error_type)",
          "limit": 50,
          "tableType": "spans"
