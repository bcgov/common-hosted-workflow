      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": ["workflow_name", "Value #Total", "Value #Success", "Value #Failed", "Value #AvgDur"]
            }
          }
        }
      ],
      "targets": [
        {
          "refId": "Total",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": "",
          "expr": "sum by(workflow_name)(  increase(n8n_workflow_execution_duration_seconds_count{workflow_id=~\"$workflow_id\"}[$__range])  * on(workflow_id) group_left(workflow_name) last_over_time(n8n:workflow_name:current{workflow_id=~\"$workflow_id\"}[$__range])) >= 0.5"
