          "uid": "n8n-projects"
        },
        "query": {
          "refId": "variable",
          "queryType": "infinity",
          "infinityQuery": {
            "type": "json",
            "parser": "backend",
            "source": "url",
            "url": "/rest/custom/v1/obs/projects",
            "root_selector": "projects",
            "columns": [
              { "selector": "name", "text": "__text", "type": "string" },
              { "selector": "id", "text": "__value", "type": "string" }
            ],
            "filters": [],
            "format": "table",
            "url_options": {
              "method": "GET",
              "body_content_type": "text/plain"
            }
          }
        },
        "refresh": 1,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "hide": 0,
        "skipUrlSync": false,
        "current": {}
      },
      {
        "name": "workflow_id",
        "label": "Workflow",
        "type": "query",
        "regex": "^.+$",
        "datasource": {
          "type": "yesoreyeram-infinity-datasource",
          "uid": "n8n-projects"
        },
        "query": {
          "refId": "variable",
          "queryType": "infinity",
          "infinityQuery": {
            "type": "json",
            "parser": "backend",
            "source": "url",
            "url": "/rest/custom/v1/obs/projects/workflows?projectId=${project_id:raw}",
            "root_selector": "",
            "columns": [
              { "selector": "name", "text": "__text", "type": "string" },
              { "selector": "id", "text": "__value", "type": "string" }
            ],
            "filters": [],
            "format": "table",
            "url_options": {
              "method": "GET",
              "body_content_type": "text/plain"
            }
          }
        },
        "refresh": 1,
        "sort": 1,
        "includeAll": true,
        "multi": false,
        "hide": 0,
        "skipUrlSync": false,
        "current": {}
      },
      {
        "name": "status",
        "label": "Status",
        "type": "custom",
        "query": "All : status = ok || status = error || status = unset,Success : status = ok,Failed : status = error",
        "definition": "All : status = ok || status = error || status = unset,Success : status = ok,Failed : status = error",
        "current": {
          "selected": true,
          "text": "All",
          "value": "status = ok || status = error || status = unset"
        },
        "options": [
          {
            "selected": true,
