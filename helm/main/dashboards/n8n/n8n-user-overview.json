                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "round(sum(increase(n8n_workflow_success_total{workflow_id=~\"$workflow_id\"}[$__range])) + sum(increase(n8n_workflow_failed_total{workflow_id=~\"$workflow_id\"}[$__range]) or vector(0)) + sum(increase(n8n_workflow_cancelled_total{workflow_id=~\"$workflow_id\"}[$__range]) or vector(0)))",
          "instant": true,
          "range": false,
          "legendFormat": "Total"
