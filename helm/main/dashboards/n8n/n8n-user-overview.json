          "expr": "sum by(workflow_name)(  increase(n8n_workflow_execution_duration_seconds_count{workflow_id=~\"$workflow_id\",status=\"success\"}[$__range])  * on(workflow_id) group_left(workflow_name) last_over_time(n8n:workflow_name:current{workflow_id=~\"$workflow_id\"}[$__range])) >= 0.5"
        },
        {
          "refId": "Failed",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": "",
          "expr": "sum by(workflow_name)(  increase(n8n_workflow_execution_duration_seconds_count{workflow_id=~\"$workflow_id\",status=\"failed\"}[$__range])  * on(workflow_id) group_left(workflow_name) last_over_time(n8n:workflow_name:current{workflow_id=~\"$workflow_id\"}[$__range])) >= 0.5"
        },
        {
          "refId": "AvgDur",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": "",
          "expr": "(sum by(workflow_name)(  increase(n8n_workflow_execution_duration_seconds_sum{workflow_id=~\"$workflow_id\"}[$__range])  * on(workflow_id) group_left(workflow_name) last_over_time(n8n:workflow_name:current{workflow_id=~\"$workflow_id\"}[$__range])) / clamp_min(sum by(workflow_name)(  increase(n8n_workflow_execution_duration_seconds_count{workflow_id=~\"$workflow_id\"}[$__range])  * on(workflow_id) group_left(workflow_name) last_over_time(n8n:workflow_name:current{workflow_id=~\"$workflow_id\"}[$__range])), 0.001)) and on(workflow_name) (sum by(workflow_name)(  increase(n8n_workflow_execution_duration_seconds_count{workflow_id=~\"$workflow_id\"}[$__range])  * on(workflow_id) group_left(workflow_name) last_over_time(n8n:workflow_name:current{workflow_id=~\"$workflow_id\"}[$__range])) >= 0.5)"
        }
      ]
    },
