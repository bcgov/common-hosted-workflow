# Test harness: builds on the REAL production image (n8n-replica-scaler:under-test,
# built from the actual ../Dockerfile by run-tests.sh) rather than a separate
# reimplementation, so a regression in the real Dockerfile (missing tool,
# broken oc copy) is caught by these tests too, not just scale.sh's own logic.
# Adds fake `oc`/`curl` ahead of the real ones on PATH (controllable via env
# vars, see fake-oc/fake-curl) and the ConfigMap-extracted scale.sh, so the
# script under test is byte-for-byte what Helm actually renders.
ARG BASE_IMAGE=n8n-replica-scaler:under-test
FROM ${BASE_IMAGE}

# Needs root only for these build-time setup steps (writing under /var/run,
# chmod on root-owned COPYed files). The production image (this one's base)
# runs as a non-root user by default, so this must re-elevate explicitly.
USER root

RUN mkdir -p /var/run/secrets/kubernetes.io/serviceaccount \
    && echo -n "test-namespace" > /var/run/secrets/kubernetes.io/serviceaccount/namespace \
    && mkdir -p /fake-bin

COPY fake-oc /fake-bin/oc
COPY fake-curl /fake-bin/curl
COPY scale.sh /scale.sh
RUN chmod +x /fake-bin/oc /fake-bin/curl /scale.sh

USER scaler

ENV PATH="/fake-bin:${PATH}"
ENTRYPOINT ["/bin/bash", "/scale.sh"]
