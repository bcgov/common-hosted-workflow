#!/bin/bash
# Stubs `oc get ... --subresource=scale` and
# `oc patch ... --subresource=scale` for testing scale.sh without a real
# cluster. Controlled via env vars:
#   FAKE_OC_REPLICAS_<name-with-dashes-as-underscores>  - the "current"
#     replica count `oc get` returns for that Deployment name; unset/empty
#     simulates an unreadable Deployment (pre-flight failure).
#   FAKE_OC_SCALE_FAIL - a Deployment name for which the scale patch should
#     fail.
# Records every successful scale call to /tmp/scale-calls.log.
if [ "$1" = "get" ]; then
  NAME="$3"
  VARNAME="FAKE_OC_REPLICAS_$(echo "$NAME" | tr '-' '_')"
  VALUE="${!VARNAME}"
  if [ -z "$VALUE" ]; then
    exit 1
  fi
  echo -n "$VALUE"
  exit 0
elif [ "$1" = "patch" ]; then
  NAME="$3"
  if [ "${NAME}" = "${FAKE_OC_SCALE_FAIL}" ]; then
    exit 1
  fi
  for arg in "$@"; do
    case "$arg" in
      -p) EXPECT_PATCH_BODY=1 ;;
      *)
        if [ "${EXPECT_PATCH_BODY:-0}" = "1" ]; then
          REPLICAS=$(echo "$arg" | grep -o '"replicas":[0-9]*' | cut -d: -f2)
          echo "SCALE_CALL:${NAME}:${REPLICAS}" >> /tmp/scale-calls.log
          EXPECT_PATCH_BODY=0
        fi
        ;;
    esac
  done
  exit 0
elif [ "$1" = "version" ]; then
  echo "fake-oc"
  exit 0
fi
exit 1
